{
  "name": "@godz1llla/cachewitness",
  "version": "0.1.0",
  "description": "Find cross-user cache contamination with reproducible HTTP request sequences.",
  "type": "module",
  "bin": { "cachewitness": "bin/cachewitness.js" },
  "engines": { "node": ">=22" },
  "files": ["bin/", "src/", "examples/", "assets/demo.svg", "SECURITY.md", "CONTRIBUTING.md", "docs/configuration.md", "docs/methodology.md"],
  "scripts": {
    "test": "node --test",
    "demo": "node bin/cachewitness.js demo",
    "demo:fixed": "node bin/cachewitness.js demo --fixed",
    "example:server": "node examples/server.js",
    "verify:package": "node scripts/verify-package.js"
  },
  "repository": { "type": "git", "url": "git+https://github.com/godz1llla/cachewitness.git" },
  "bugs": { "url": "https://github.com/godz1llla/cachewitness/issues" },
  "homepage": "https://github.com/godz1llla/cachewitness#readme",
  "keywords": ["cache", "redis", "testing", "multi-tenant", "cache-isolation", "cli", "security-testing"],
  "license": "MIT"
}
